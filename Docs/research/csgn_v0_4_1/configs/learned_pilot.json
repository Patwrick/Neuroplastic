{
  "$schema": "../schemas/experiment_config.schema.json",
  "schema_version": "0.4.1",
  "config_id": "learned_pilot",
  "stage": "M3",
  "evidence_class": "learned_pilot",
  "model": "graph_sleep",
  "task_id": "T1",
  "seed": 0,
  "graph": {
    "columns": 512,
    "regions": 16,
    "out_slots": 16,
    "protected_slots": 4,
    "state_dim": 64,
    "message_dim": 16,
    "heads": 4,
    "descriptor_dim": 16,
    "active_regions": 4,
    "active_senders": 64,
