  "resources": {
    "device": "auto",
    "precision": "float32",
    "max_job_seconds": 7200,
    "max_output_bytes": 2000000000,
    "max_pending_records": 128,
    "max_replay_records": 2048,
    "max_hot_edge_identities": 8192,
    "allow_paid_compute": false,
    "allow_external_downloads": false
