FROM mambaorg/micromamba:1.5.8

USER root
SHELL ["/bin/bash", "-lc"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xauth \
    mesa-utils \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libegl1-mesa \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

RUN micromamba install -y -n base -c conda-forge python=3.10 openjdk=8 pip \
    && micromamba clean --all --yes

# Use the conda base env's Python/Pip for subsequent RUN/CMD steps.
ENV PATH="/opt/conda/bin:${PATH}"

WORKDIR /workspace

COPY requirements-core.txt requirements-minestudio.txt requirements-ml.txt /workspace/

RUN python --version \
    && pip --version \
    && pip install --no-cache-dir \
    -r requirements-core.txt \
    -r requirements-minestudio.txt \
    -r requirements-ml.txt

COPY . /workspace

CMD ["bash"]
