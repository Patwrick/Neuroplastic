{
  "$schema": "../schemas/experiment_config.schema.json",
  "schema_version": "0.4.1",
  "config_id": "m2_smoke_all_writes",
  "stage": "M2",
  "evidence_class": "implementation_smoke",
  "model": "graph_sleep",
  "task_id": "T1",
  "seed": 0,
  "graph": {
    "columns": 64,
    "regions": 8,
    "out_slots": 8,
    "protected_slots": 4,
    "state_dim": 32,
    "message_dim": 16,
    "heads": 2,
    "descriptor_dim": 8,
    "active_regions": 2,
    "active_senders": 16,
    "real_routes_per_sender": 4,
    "incoming_capacity": 32,
    "updated_node_cap": 64,
    "inner_rounds": 4,
    "output_receivers": [
      0,
      1,
      2,
      3
    ],
    "support_policy": "protected_output_slot_plus_topk",
    "address_mode": "state_dependent"
  },
  "workspace": {
    "kappa": 0.5,
    "Ah_spectral_norm_max": 0.25,
    "Br_times_Lm_max": 0.5,
    "required_q_max": 0.875
  },
  "learning": {
    "feasibility": "four_endpoint",
    "wmax": 1.0,
    "pmax": 1.0,
    "beta": 0.7,
    "rate_epsilon": 1e-08,
    "per_edge_allowance": 0.05,
    "total_write_budget": 0.5,
    "admissible_decay": 1.0,
    "ephemeral_time_constant": 100.0,
    "gradient_mode": "continuous_full_path_conditional_support",
    "projection": "exact_intersection_box",
    "hot_state_layout": "dense_correctness_reference"
  },
  "task": {
    "cue_dim": 16,
    "context_dim": 8,
    "classes": 8,
    "target_dim": 8,
    "target_scale": 0.1,
    "contexts_per_lifetime": 2,
    "cues_per_context": 4,
    "support_passes": 1,
    "queries_per_context": 8,
    "feedback_delays": [
      0
    ],
    "query_feedback": false,
    "episode_answer_retrieval": false
  },
  "training": {
    "train_shared_theta": false,
    "outer_episodes": 2,
    "batch_lifetimes": 1,
    "outer_lr": 0.001,
    "outer_optimizer": "Adam",
    "max_outer_steps": 2
  },
  "sleep": {
    "mode": "synchronous_reset_boundary",
    "enabled": true,
    "shared_theta_frozen": true,
    "fast_disabled_during_fit": true,
    "max_steps": 4,
    "optimizer": "Adam",
    "lr": 0.001,
    "replay_batch_size": 8,
    "candidate_quantization": "none"
  },
  "evaluation": {
    "per_task_episodes": 8,
    "cold_disable_residuals": true,
    "cold_disable_writes": true,
    "cold_reset_workspace_wm": true,
    "cold_disable_answer_retrieval": true,
    "diagnostic_snapshot_rate": 1.0,
    "max_oracle_calls": 8
  },
  "acceptance": {
    "level": "empirical_screen",
    "development_episodes": 8,
    "max_old_loss_increase": 0.01,
    "min_new_improvement": 0.0,
    "formal_delta_lifetime": null,
    "claim": "development screen only; no lifetime guarantee"
  },
  "resources": {
    "device": "cpu",
    "precision": "float32",
    "max_job_seconds": 180,
    "max_output_bytes": 100000000,
    "max_pending_records": 32,
    "max_replay_records": 128,
    "max_hot_edge_identities": 512,
    "allow_paid_compute": false,
    "allow_external_downloads": false
  },
  "disabled_extensions": [
    "rewiring",
    "INT4",
    "offloading",
    "asynchronous_sleep",
    "online_theta_updates",
    "learned_internal_teacher",
    "Minecraft"
  ],
  "notes": [
    "Engineering smoke defaults; not a powered efficacy study.",
    "S/Pa/Pu belong to individual lifetimes, never averaged across the batch.",
    "M2 audit inspects all eight support writes per graph lifetime, within the original max_oracle_calls=8 and runtime caps."
  ]
}
